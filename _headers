/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self)
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self' https://formsubmit.co; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://formsubmit.co

/assets/*
  Cache-Control: public, max-age=86400
